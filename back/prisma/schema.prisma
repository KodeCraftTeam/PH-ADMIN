generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserModel {
  @@map("Users")
  id                   String                      @id
  email                String                      @unique
  password             String?                     @default("")
  name                 String
  role                 String?
  status               String
  code                 String?
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  administratorProfile AdministratorProfileModel?
}

model CityModel {
  @@map("Cities")
  id                     String                       @id
  name                   String                       @unique
  administratorProfiles  AdministratorProfileModel[]
  communities            CommunityModel[]
}

model AdministratorProfileModel {
  @@map("AdministratorProfiles")
  id                       String                        @id
  userId                   String                        @unique @map("user_id")
  user                     UserModel                     @relation(fields: [userId], references: [id])
  personType               String                        @map("person_type")
  nameOrBusinessName       String                        @map("name_or_business_name")
  taxId                    String                        @unique @map("tax_id")
  phoneNumber              String?                       @map("phone_number")
  address                  String?
  cityId                   String                        @map("city_id")
  city                     CityModel                     @relation(fields: [cityId], references: [id])
  legalRepresentative      String?                       @map("legal_representative")
  createdAt                DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime?                     @updatedAt @map("updated_at")
  administratorCommunities AdministratorCommunityModel[]
}

model CommunityModel {
  @@map("communities")
  id                       String                        @id @default(uuid())
  name                     String
  taxId                    String                        @map("tax_id")
  address                  String
  cityId                   String                        @map("city_id")
  city                     CityModel                     @relation(fields: [cityId], references: [id])
  type                     String                        @default("RESIDENCIAL")
  totalUnits               Int                           @map("total_units")
  status                   String                        @default("EN_CONFIGURACION")
  createdAt                DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime?                     @updatedAt @map("updated_at")
  administratorCommunities AdministratorCommunityModel[]
  unitGroups               UnitGroupModel[]
  units                    UnitModel[]
}

model AdministratorCommunityModel {
  @@map("administrator_community")
  id              String                    @id @default(uuid())
  administratorId String                    @map("administrator_id")
  administrator   AdministratorProfileModel @relation(fields: [administratorId], references: [id])
  communityId     String                    @map("community_id")
  community       CommunityModel            @relation(fields: [communityId], references: [id])

  @@unique([administratorId, communityId])
}

model UnitGroupModel {
  @@map("unit_groups")
  id          String         @id @default(uuid())
  communityId String         @map("community_id")
  community   CommunityModel @relation(fields: [communityId], references: [id])
  type        String
  name        String
  sortOrder   Int?           @map("sort_order")
  units       UnitModel[]

  @@unique([communityId, name])
}

model UnitModel {
  @@map("units")
  id                         String                    @id @default(uuid())
  communityId                String                    @map("community_id")
  community                  CommunityModel            @relation(fields: [communityId], references: [id])
  groupId                    String?                   @map("group_id")
  group                      UnitGroupModel?           @relation(fields: [groupId], references: [id])
  identifier                 String
  type                       String
  floor                      Int?
  privateAreaM2              Decimal                   @map("private_area_m2") @db.Decimal(10, 4)
  coefficient                Decimal?                  @db.Decimal(10, 4)
  coefficientOrigin          String?                   @map("coefficient_origin")
  propertyRegistrationNumber String?                   @map("property_registration_number")
  use                        String?
  status                     String                    @default("ACTIVA")
  createdAt                  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime?                 @updatedAt @map("updated_at")
  ownerships                 PropertyOwnershipModel[]
  initialBalance             InitialBalanceModel?

  @@unique([communityId, identifier])
  @@unique([communityId, propertyRegistrationNumber])
}

model InitialBalanceModel {
  @@map("initial_balances")
  id         String    @id @default(uuid())
  unitId     String    @unique @map("unit_id")
  unit       UnitModel @relation(fields: [unitId], references: [id])
  balanceCOP Decimal   @map("balance_cop") @db.Decimal(14, 2)
  cutoffDate DateTime  @map("cutoff_date") @db.Date
  status     String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime? @updatedAt @map("updated_at")
}

model PersonModel {
  @@map("persons")
  id                     String                   @id @default(uuid())
  personType             String                   @map("person_type")
  documentType           String                   @map("document_type")
  documentNumber         String                   @unique @map("document_number")
  fullNameOrBusinessName String                   @map("full_name_or_business_name")
  email                  String?
  phone                  String?
  notificationAddress    String?                  @map("notification_address")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  ownerships             PropertyOwnershipModel[]
}

model PropertyOwnershipModel {
  @@map("property_ownerships")
  id                  String      @id @default(uuid())
  unitId              String      @map("unit_id")
  unit                UnitModel   @relation(fields: [unitId], references: [id])
  personId            String      @map("person_id")
  person              PersonModel @relation(fields: [personId], references: [id])
  ownershipPercentage Decimal     @map("ownership_percentage") @db.Decimal(6, 3)
  startDate           DateTime    @map("start_date") @db.Date
  endDate             DateTime?   @map("end_date") @db.Date
  isPrimary           Boolean     @map("is_primary")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
}