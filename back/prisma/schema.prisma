generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserModel {
  @@map("Users")
  id           String     @id
  email        String     @unique
  password     String?    @default("")
  name         String     
  role         String?     
  status       String     
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
}